<section id="products" class="scroll-mt-24 bg-white py-20 md:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Heading -->
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-600">
        Our Products
      </p>
      <h2 class="mt-4 text-3xl font-bold leading-tight text-slate-900 md:text-4xl lg:text-5xl">
        Quality Medicines,
        <span class="text-blue-600">
          Trusted Healthcare
        </span>
      </h2>
      <p class="mt-6 text-base leading-8 text-slate-600 md:text-lg">
        Explore Medvix's growing portfolio of pharmaceutical products
        developed with quality, innovation and patient care at the core.
      </p>
    </div>
    <!-- Products -->
    <div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
      <% @products.each do |product| %>

        <div class="group flex h-full flex-col overflow-hidden rounded-3xl border border-slate-100 bg-white shadow-sm transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl">

          <div class="flex h-72 items-center justify-center overflow-hidden bg-gradient-to-br from-blue-50 to-blue-100">

            <% if product.image.attached? %>
              <%= image_tag product.image,
                    class: "max-h-60 transition duration-500 group-hover:scale-110" %>
            <% else %>
              <div class="flex h-full w-full items-center justify-center text-slate-400">
                Product Image
              </div>
            <% end %>

          </div>

          <div class="flex flex-grow flex-col p-7">

            <span class="text-sm font-semibold uppercase tracking-wide text-blue-600">
              <%= product.segment %>
            </span>

            <h3 class="mt-3 text-2xl font-bold text-slate-900">
              <%= product.name %>
            </h3>

            <p class="mt-4 flex-grow leading-7 text-slate-600">
              <%= product.short_description %>
            </p>

            <%= link_to product_path(product.slug),
                  class: "mt-6 inline-flex items-center font-semibold text-blue-600 transition group-hover:text-blue-800" do %>

              View Details

              <span class="ml-2 transition-transform duration-300 group-hover:translate-x-2">
                →
              </span>

            <% end %>

          </div>

        </div>

      <% end %>
    </div>
    <!-- CTA -->
    <div class="mt-16 text-center">
      <%= link_to products_path,
      class: "inline-flex items-center rounded-xl bg-blue-700 px-8 py-4 font-semibold text-white shadow-lg transition duration-300 hover:bg-blue-800 hover:shadow-xl" do %>

        View Complete Product Portfolio

      <% end %>
    </div>
  </div>
</section>
