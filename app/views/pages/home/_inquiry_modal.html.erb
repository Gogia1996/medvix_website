<div
  data-modal-target="modal"
  class="fixed inset-0 z-50 hidden overflow-y-auto bg-black/60">

  <div class="flex min-h-screen items-start justify-center p-4 py-10">

    <div class="relative w-full max-w-2xl max-h-[90vh] overflow-y-auto bg-white shadow-2xl">

      <!-- Header -->
      <div class="flex items-center justify-between border-b border-slate-200 px-8 py-6">
        <div>
          <h2 class="text-2xl font-bold text-slate-900">
            Send Inquiry
          </h2>
          <p class="mt-1 text-sm text-slate-500">
            We'd love to hear from you. Fill in the details below.
          </p>
        </div>

        <button
          type="button"
          data-action="click->modal#close"
          class="rounded-lg p-2 text-2xl text-slate-400 hover:bg-slate-100">
          &times;
        </button>
      </div>

      <!-- Turbo Frame -->
      <%= turbo_frame_tag "inquiry_form" do %>
        <%= render "inquiries/form", inquiry: Inquiry.new %>
      <% end %>

    </div>

  </div>

</div>
