<section id="hero" class="relative overflow-hidden bg-gradient-to-br from-blue-50 via-white to-green-50 scroll-mt-24">
  <!-- Background Blur -->
  <div class="absolute -top-20 -left-20 h-60 w-60 rounded-full bg-blue-200/30 blur-3xl md:h-72 md:w-72"></div>
  <div class="absolute bottom-0 right-0 h-72 w-72 rounded-full bg-green-200/30 blur-3xl md:h-96 md:w-96"></div>
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <!-- LEFT CONTENT -->
      <div class="text-center lg:text-left">
        <span class="inline-flex rounded-full bg-blue-100 px-4 py-2 text-xs font-semibold uppercase tracking-wide text-blue-700 md:text-sm">
          Trusted Pharmaceutical Company
        </span>
        <h1 class="mt-6 text-4xl font-extrabold leading-tight text-slate-900 md:text-5xl lg:text-6xl">
          Delivering Better
          <span class="text-blue-700">Healthcare Through</span>
          Innovation &
          <span class="text-green-600">Quality Medicines</span>
        </h1>
        <p class="mx-auto mt-6 max-w-xl text-base leading-7 text-slate-600 md:text-lg md:leading-8 lg:mx-0">
          Medvix Pharmaceuticals is dedicated to building a trusted healthcare
          brand through quality medicines, ethical practices, and a commitment
          to improving patient care across India.
        </p>
        <!-- Buttons -->
        <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:justify-center lg:justify-start">
          <a href="#products"
             class="rounded-xl bg-blue-700 px-8 py-4 text-center font-semibold text-white transition hover:bg-blue-800">
            Explore Products
          </a>
          <a href="#contact"
             class="rounded-xl border border-slate-300 px-8 py-4 text-center font-semibold transition hover:border-blue-700 hover:text-blue-700">
            Contact Us
          </a>
        </div>
        <!-- Stats -->
        <div class="mt-12 grid grid-cols-3 gap-6 text-center lg:text-left">
          <div>
            <h3 class="text-2xl font-bold text-blue-700 md:text-3xl">
              10+
            </h3>
            <p class="mt-1 text-sm text-slate-500">
              Products
            </p>
          </div>
          <div>
            <h3 class="text-2xl font-bold text-green-600 md:text-3xl">
              20+
            </h3>
            <p class="mt-1 text-sm text-slate-500">
              Segments
            </p>
          </div>
          <div>
            <h3 class="text-xl font-bold text-blue-700 md:text-2xl">
              PAN India
            </h3>
            <p class="mt-1 text-sm text-slate-500">
              Distribution
            </p>
          </div>
        </div>
      </div>
      <!-- RIGHT CONTENT -->
      <div class="relative order-first flex justify-center lg:order-last">
        <!-- Background Glow -->
        <div class="absolute inset-0 -z-10 flex items-center justify-center">
          <div class="h-72 w-72 rounded-full bg-gradient-to-r from-blue-200/40 to-green-200/40 blur-3xl md:h-[450px] md:w-[450px]"></div>
        </div>
        <%= image_tag "hero-illustration.png",
            alt: "Medvix Healthcare Illustration",
            class: "relative z-10 w-full max-w-xs drop-shadow-2xl sm:max-w-sm md:max-w-md lg:max-w-lg xl:max-w-xl" %>
      </div>
    </div>
  </div>
</section>

