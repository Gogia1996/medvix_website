<section id="contact" class="scroll-mt-24 bg-white py-20 md:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Heading -->
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-600">
        Contact Us
      </p>
      <h2 class="mt-4 text-3xl font-bold leading-tight text-slate-900 md:text-4xl lg:text-5xl">
        Let's Build A
        <span class="text-blue-600">
          Healthier Future Together
        </span>
      </h2>
      <p class="mt-6 text-base leading-8 text-slate-600 md:text-lg">
        Connect with Medvix for product inquiries, business partnerships,
        distributorship opportunities, and healthcare collaborations.
      </p>
    </div>
    <!-- Contact Cards -->
    <div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
      <!-- Address -->
      <div class="group flex h-full flex-col items-center rounded-3xl border border-blue-100 bg-gradient-to-br from-blue-50 to-white p-8 text-center shadow-sm transition-all duration-300 hover:-translate-y-2 hover:border-blue-200 hover:shadow-xl">
        <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-blue-600 text-white transition duration-300 group-hover:scale-110 group-hover:rotate-6">
          <span class="text-2xl">📍</span>
        </div>
        <h3 class="mt-6 text-2xl font-bold text-slate-900">
          Our Location
        </h3>
        <p class="mt-4 flex-grow leading-7 text-slate-600">
          Medvix Pharmaceuticals<br>
          India
        </p>
      </div>
      <!-- Email -->
      <div class="group flex h-full flex-col items-center rounded-3xl border border-cyan-100 bg-gradient-to-br from-cyan-50 to-white p-8 text-center shadow-sm transition-all duration-300 hover:-translate-y-2 hover:border-cyan-200 hover:shadow-xl">
        <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-cyan-500 text-white transition duration-300 group-hover:scale-110 group-hover:rotate-6">
          <span class="text-2xl">✉️</span>
        </div>
        <h3 class="mt-6 text-2xl font-bold text-slate-900">
          Email Us
        </h3>
        <a href="mailto:contact@medvix.com"
           class="mt-4 break-all leading-7 text-slate-600 transition hover:text-cyan-600">
          contact@medvix.com
        </a>
      </div>
      <!-- Phone -->
      <div class="group flex h-full flex-col items-center rounded-3xl border border-green-100 bg-gradient-to-br from-green-50 to-white p-8 text-center shadow-sm transition-all duration-300 hover:-translate-y-2 hover:border-green-200 hover:shadow-xl">
        <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-green-600 text-white transition duration-300 group-hover:scale-110 group-hover:rotate-6">
          <span class="text-2xl">📞</span>
        </div>
        <h3 class="mt-6 text-2xl font-bold text-slate-900">
          Call Us
        </h3>
        <a href="tel:+910000000000"
           class="mt-4 leading-7 text-slate-600 transition hover:text-green-600">
          +91 XXXXX XXXXX
        </a>
      </div>
    </div>
    <!-- CTA -->
    <div class="mt-16 overflow-hidden rounded-[32px] bg-gradient-to-r from-blue-700 via-blue-600 to-cyan-500 p-10 text-center text-white shadow-xl md:p-14">
      <h3 class="text-3xl font-bold md:text-4xl">
        Partner With Medvix
      </h3>
      <p class="mx-auto mt-5 max-w-2xl text-base leading-8 text-blue-100 md:text-lg">
        Whether you're a healthcare professional, distributor, or business
        partner, we'd love to discuss how we can work together to deliver
        better healthcare solutions.
      </p>
      <div class="mt-8">
        <button
          type="button"
          data-action="click->modal#open"
          class="group inline-flex cursor-pointer items-center rounded-xl bg-white px-8 py-4 font-semibold text-blue-700 shadow-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl">
          Send Inquiry

          <span class="ml-2 transition-transform duration-300 group-hover:translate-x-1">
            →
          </span>
        </button>
      </div>
    </div>
  </div>
</section>
