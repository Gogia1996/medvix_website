<header
  class="sticky top-0 z-50 border-b border-slate-200 bg-white/95 backdrop-blur-md"
  data-controller="mobile-menu">

  <div class="container-custom flex h-16 items-center justify-between md:h-24">

    <!-- Logo -->
    <%= link_to root_path, class: "flex items-center" do %>
      <%= image_tag "logo.jpeg",
          alt: "Medvix Pharmaceuticals",
          class: "h-10 w-auto md:h-16" %>
    <% end %>

    <!-- Desktop Navigation -->
    <nav class="hidden md:block">
      <ul class="flex items-center gap-8 text-[15px] font-medium text-slate-700">
        <li>
          <%= link_to "Home",
                root_path,
                class: "transition-colors hover:text-blue-700" %>
        </li>

        <li>
          <%= link_to "About",
                root_path(anchor: "about"),
                class: "transition-colors hover:text-blue-700" %>
        </li>

        <li>
          <%= link_to "Products",
                root_path(anchor: "products"),
                class: "transition-colors hover:text-blue-700" %>
        </li>

        <li>
          <%= link_to "Segments",
                root_path(anchor: "segments"),
                class: "transition-colors hover:text-blue-700" %>
        </li>

        <li>
          <%= link_to "Contact",
                root_path(anchor: "contact"),
                class: "transition-colors hover:text-blue-700" %>
        </li>
      </ul>
    </nav>

    <!-- Desktop CTA -->
    <%= link_to "Get in Touch",
          root_path(anchor: "contact"),
          class: "hidden rounded-xl bg-[#0A3A8D] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#082f73] md:inline-flex" %>

    <!-- Mobile Menu Button -->
    <button
      type="button"
      data-action="click->mobile-menu#toggle"
      class="flex h-10 w-10 items-center justify-center rounded-lg border border-slate-200 md:hidden">

      <svg xmlns="http://www.w3.org/2000/svg"
           fill="none"
           viewBox="0 0 24 24"
           stroke-width="2"
           stroke="currentColor"
           class="h-6 w-6">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>

    </button>

  </div>

  <!-- Mobile Menu -->
  <div
    data-mobile-menu-target="menu"
    class="hidden border-t border-slate-200 bg-white md:hidden">

    <nav class="flex flex-col p-4">

      <%= link_to "Home",
            root_path,
            class: "py-3" %>

      <%= link_to "About",
            root_path(anchor: "about"),
            class: "py-3" %>

      <%= link_to "Products",
            root_path(anchor: "products"),
            class: "py-3" %>

      <%= link_to "Segments",
            root_path(anchor: "segments"),
            class: "py-3" %>

      <%= link_to "Contact",
            root_path(anchor: "contact"),
            class: "py-3" %>

      <%= link_to "Get in Touch",
            root_path(anchor: "contact"),
            class: "mt-4 rounded-lg bg-[#0A3A8D] py-3 text-center text-white" %>

    </nav>

  </div>

</header>
