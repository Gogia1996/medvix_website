<footer class="border-t border-slate-200 bg-slate-50">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-3">
      <!-- Brand -->
      <div>
        <a href="#hero" class="flex items-center">
          <%= image_tag "logo.jpeg",
              alt: "Medvix Pharmaceuticals",
              class: "h-14 w-auto" %>
        </a>
        <p class="mt-6 max-w-sm leading-7 text-slate-600">
          Delivering trusted pharmaceutical solutions through quality,
          innovation, and patient-focused healthcare across India.
        </p>
      </div>
      <!-- Quick Links -->
      <div>
        <h3 class="text-lg font-bold text-slate-900">
          Quick Links
        </h3>
        <ul class="mt-6 space-y-4">
          <li>
            <a href="#about"
               class="transition duration-300 hover:text-blue-600">
              About Us
            </a>
          </li>
          <li>
            <a href="#segments"
               class="transition duration-300 hover:text-blue-600">
              Our Segments
            </a>
          </li>
          <li>
            <a href="#products"
               class="transition duration-300 hover:text-blue-600">
              Products
            </a>
          </li>
          <li>
            <a href="#why-choose-us"
               class="transition duration-300 hover:text-blue-600">
              Why Choose Us
            </a>
          </li>
          <li>
            <a href="#contact"
               class="transition duration-300 hover:text-blue-600">
              Contact
            </a>
          </li>
        </ul>
      </div>
      <!-- Contact -->
      <div>
        <h3 class="text-lg font-bold text-slate-900">
          Contact Information
        </h3>
        <div class="mt-6 space-y-5">
          <div>
            <p class="text-sm font-semibold uppercase tracking-wide text-slate-500">
              Email
            </p>
            <a href="mailto:contact@medvix.com"
               class="mt-1 inline-block transition hover:text-blue-600">
              contact@medvix.com
            </a>
          </div>
          <div>
            <p class="text-sm font-semibold uppercase tracking-wide text-slate-500">
              Phone
            </p>

            <a href="tel:+910000000000"
               class="mt-1 inline-block transition hover:text-blue-600">
              +91 XXXXX XXXXX
            </a>
          </div>
          <div>
            <p class="text-sm font-semibold uppercase tracking-wide text-slate-500">
              Location
            </p>
            <p class="mt-1 text-slate-600">
              India
            </p>
          </div>
        </div>
      </div>
    </div>
    <!-- Bottom Bar -->
    <div class="mt-14 border-t border-slate-200 pt-8">
      <div class="flex flex-col items-center justify-between gap-5 text-center md:flex-row">
        <p class="text-sm text-slate-500">
          © <%= Date.current.year %> Medvix Pharmaceuticals. All Rights Reserved.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-6">
          <a href="#"
             class="text-sm text-slate-500 transition hover:text-blue-600">
            Privacy Policy
          </a>
          <a href="#"
             class="text-sm text-slate-500 transition hover:text-blue-600">
            Terms & Conditions
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
