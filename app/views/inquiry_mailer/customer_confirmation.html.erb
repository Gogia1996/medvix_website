<!DOCTYPE html>
<html>
  <body style="margin:0;padding:0;background:#f8fafc;font-family:Arial,Helvetica,sans-serif;">

    <table width="100%" cellpadding="0" cellspacing="0" style="padding:40px 0;">
      <tr>
        <td align="center">

          <table width="650" cellpadding="0" cellspacing="0"
                 style="background:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 5px 20px rgba(0,0,0,.08);">

            <!-- Header -->
            <tr>
              <td style="background:#2563eb;padding:30px;text-align:center;">
                <h1 style="margin:0;color:#ffffff;">
                  Medvix
                </h1>

                <p style="margin-top:8px;color:#dbeafe;">
                  Thank You for Contacting Us
                </p>
              </td>
            </tr>

            <!-- Content -->
            <tr>
              <td style="padding:35px;">

                <p style="font-size:16px;color:#334155;">
                  Dear <strong><%= @inquiry.name %></strong>,
                </p>

                <p style="color:#475569;line-height:1.8;">
                  Thank you for contacting <strong>Medvix</strong>.
                </p>

                <p style="color:#475569;line-height:1.8;">
                  We have successfully received your inquiry.
                </p>

                <p style="color:#475569;line-height:1.8;">
                  Our team will review your message and get back to you as soon as possible.
                </p>

                <div style="margin-top:30px;padding:18px;background:#eff6ff;border-left:4px solid #2563eb;border-radius:6px;">
                  <strong>Your Inquiry</strong><br><br>

                  <strong>Subject:</strong>
                  <%= @inquiry.subject.presence || "General Inquiry" %>

                  <br><br>

                  <strong>Message:</strong><br>
                  <%= simple_format(@inquiry.message) %>
                </div>

                <p style="margin-top:35px;color:#475569;">
                  Thank you for choosing Medvix.
                </p>

                <p style="margin-top:25px;">
                  Regards,<br>
                  <strong>Medvix Team</strong>
                </p>

              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td style="background:#f1f5f9;padding:20px;text-align:center;font-size:13px;color:#64748b;">
                © <%= Date.current.year %> Medvix Pharmaceuticals.
              </td>
            </tr>

          </table>

        </td>
      </tr>
    </table>

  </body>
</html>
