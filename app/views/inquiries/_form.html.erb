<%= form_with model: inquiry do |form| %>

  <div class="px-8 py-6">
    <% if inquiry.errors.any? %>
      <div class="mx-8 mt-6 rounded-xl border border-red-200 bg-red-50 p-4">
        <h3 class="font-semibold text-red-700">
          Please fix the following errors:
        </h3>

        <ul class="mt-2 list-disc pl-5 text-sm text-red-600">
          <% inquiry.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="grid grid-cols-1 gap-5 md:grid-cols-2">

      <div>
        <%= form.label :name, class: "mb-2 block text-sm font-medium text-slate-700" %>
        <%= form.text_field :name,
              required: true,
              placeholder: "Enter your name",
              class: "w-full rounded-xl border border-slate-300 px-4 py-3 transition focus:border-blue-600 focus:ring-2 focus:ring-blue-100 focus:outline-none" %>
      </div>

      <div>
        <%= form.label :email, class: "mb-2 block text-sm font-medium text-slate-700" %>
        <%= form.email_field :email,
              required: true,
              placeholder: "Enter your email",
              class: "w-full rounded-xl border border-slate-300 px-4 py-3 transition focus:border-blue-600 focus:ring-2 focus:ring-blue-100 focus:outline-none" %>
      </div>

      <div>
        <%= form.label :phone, class: "mb-2 block text-sm font-medium text-slate-700" %>
        <%= form.telephone_field :phone,
              placeholder: "Enter your phone",
              class: "w-full rounded-xl border border-slate-300 px-4 py-3 transition focus:border-blue-600 focus:ring-2 focus:ring-blue-100 focus:outline-none" %>
      </div>

      <div>
        <%= form.label :company, class: "mb-2 block text-sm font-medium text-slate-700" %>
        <%= form.text_field :company,
              placeholder: "Company name",
              class: "w-full rounded-xl border border-slate-300 px-4 py-3 transition focus:border-blue-600 focus:ring-2 focus:ring-blue-100 focus:outline-none" %>
      </div>

    </div>

    <div class="mt-5">
      <%= form.label :subject, class: "mb-2 block text-sm font-medium text-slate-700" %>
      <%= form.text_field :subject,
            placeholder: "Subject",
            class: "w-full rounded-xl border border-slate-300 px-4 py-3 transition focus:border-blue-600 focus:ring-2 focus:ring-blue-100 focus:outline-none" %>
    </div>

    <div class="mt-5">
      <%= form.label :message, class: "mb-2 block text-sm font-medium text-slate-700" %>
      <%= form.text_area :message,
            required: true,
            rows: 6,
            placeholder: "Write your message...",
            class: "w-full rounded-xl border border-slate-300 px-4 py-3 transition focus:border-blue-600 focus:ring-2 focus:ring-blue-100 focus:outline-none resize-none" %>
    </div>

  </div>

  <div class="flex items-center justify-end gap-3 border-t border-slate-200 bg-slate-50 px-8 py-5">

    <button
      type="button"
      data-action="click->modal#close"
      class="rounded-xl border border-slate-300 px-6 py-3 font-medium text-slate-700 transition hover:bg-slate-100">
      Cancel
    </button>

    <%= form.submit "Send Inquiry",
      data: { disable_with: "Sending..." },
      class: "rounded-xl bg-blue-600 px-8 py-3 font-semibold text-white transition hover:bg-blue-700 disabled:cursor-not-allowed disabled:opacity-70" %>

  </div>

<% end %>
