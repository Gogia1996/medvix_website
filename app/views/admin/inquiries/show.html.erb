<div>

  <!-- Header -->
  <div class="flex items-center justify-between">

    <div>

      <h1 class="text-4xl font-bold text-slate-900">
        Inquiry Details
      </h1>

      <p class="mt-2 text-slate-500">
        View complete customer inquiry information.
      </p>

    </div>

  </div>

  <!-- Contact Information -->
  <div class="mt-10 rounded-3xl bg-white p-8 shadow ring-1 ring-slate-200">

    <h2 class="mb-8 text-2xl font-bold text-slate-900">
      Contact Information
    </h2>

    <div class="grid grid-cols-2 gap-x-16 gap-y-8">

      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-slate-500">
          Name
        </p>

        <p class="mt-2 text-lg font-semibold text-slate-900">
          <%= @inquiry.name %>
        </p>
      </div>

      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-slate-500">
          Email
        </p>

        <p class="mt-2 text-lg text-slate-800">
          <%= @inquiry.email %>
        </p>
      </div>

      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-slate-500">
          Phone
        </p>

        <p class="mt-2 text-lg text-slate-800">
          <%= @inquiry.phone %>
        </p>
      </div>

      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-slate-500">
          Company
        </p>

        <p class="mt-2 text-lg text-slate-800">
          <%= @inquiry.company.presence || "-" %>
        </p>
      </div>

    </div>

  </div>

  <!-- Inquiry Information -->
  <div class="mt-8 rounded-3xl bg-white p-8 shadow ring-1 ring-slate-200">

    <h2 class="mb-8 text-2xl font-bold text-slate-900">
      Inquiry Information
    </h2>

    <div class="grid grid-cols-3 gap-8">

      <div>

        <p class="text-sm font-semibold uppercase tracking-wide text-slate-500">
          Subject
        </p>

        <p class="mt-2 text-lg text-slate-900">
          <%= @inquiry.subject.presence || "-" %>
        </p>

      </div>

      <div>

        <p class="text-sm font-semibold uppercase tracking-wide text-slate-500">
          Status
        </p>

        <div class="mt-3">

          <% if @inquiry.pending? %>

            <span class="rounded-full bg-yellow-100 px-4 py-2 text-sm font-semibold text-yellow-700">
              Pending
            </span>

          <% elsif @inquiry.contacted? %>

            <span class="rounded-full bg-blue-100 px-4 py-2 text-sm font-semibold text-blue-700">
              Contacted
            </span>

          <% elsif @inquiry.closed? %>

            <span class="rounded-full bg-green-100 px-4 py-2 text-sm font-semibold text-green-700">
              Closed
            </span>

          <% end %>

        </div>

      </div>

      <div>

        <p class="text-sm font-semibold uppercase tracking-wide text-slate-500">
          Received
        </p>

        <p class="mt-2 text-lg text-slate-900">
          <%= @inquiry.created_at.strftime("%d %B %Y") %>
        </p>

      </div>

    </div>

  </div>

  <!-- Message -->
  <div class="mt-8 rounded-3xl bg-white p-8 shadow ring-1 ring-slate-200">

    <h2 class="mb-6 text-2xl font-bold text-slate-900">
      Message
    </h2>

    <div class="rounded-2xl bg-slate-50 p-6 leading-8 text-slate-700 ring-1 ring-slate-200">

      <%= simple_format(@inquiry.message) %>

    </div>

  </div>

  <!-- Actions -->
  <div class="mt-8 flex items-center justify-end gap-4">

    <%= link_to admin_inquiries_path,
          class: "rounded-xl border border-slate-300 bg-white px-6 py-3 font-medium text-slate-700 transition hover:bg-slate-50" do %>

      Back

    <% end %>

    <%= link_to "Delete Inquiry",
          admin_inquiry_path(@inquiry),
          data: {
            turbo_method: :delete,
            turbo_confirm: "Are you sure you want to delete this inquiry?"
          },
          class: "rounded-xl bg-red-600 px-6 py-3 font-semibold text-white transition hover:bg-red-700" %>

  </div>

</div>
