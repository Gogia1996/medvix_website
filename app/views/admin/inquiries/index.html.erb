<div>

  <!-- Header -->
  <div class="flex items-center justify-between">

    <div>

      <h1 class="text-4xl font-bold text-slate-900">
        Inquiries
      </h1>

      <p class="mt-2 text-slate-500">
        Manage customer inquiries received from the website.
      </p>

    </div>

  </div>

  <!-- Table -->
  <div class="mt-10 overflow-hidden rounded-3xl bg-white shadow ring-1 ring-slate-200">

    <table class="w-full">

      <thead class="bg-slate-50">

        <tr>

          <th class="w-2/5 px-6 py-4 text-left text-sm font-semibold text-slate-700">
            Contact
          </th>

          <th class="w-1/5 px-6 py-4 text-left text-sm font-semibold text-slate-700">
            Subject
          </th>

          <th class="w-1/6 px-6 py-4 text-left text-sm font-semibold text-slate-700">
            Status
          </th>

          <th class="w-1/6 px-6 py-4 text-left text-sm font-semibold text-slate-700">
            Received
          </th>

          <th class="px-6 py-4 text-right text-sm font-semibold text-slate-700">
            Actions
          </th>

        </tr>

      </thead>

      <tbody class="divide-y divide-slate-100">

        <% @inquiries.each do |inquiry| %>

          <tr class="hover:bg-slate-50">

            <!-- Contact -->
            <td class="px-6 py-5 align-middle">

              <p class="font-semibold text-slate-900">
                <%= inquiry.name %>
              </p>

              <p class="text-sm text-slate-500">
                <%= inquiry.email %>
              </p>

              <p class="text-sm text-slate-500">
                <%= inquiry.phone %>
              </p>

              <% if inquiry.company.present? %>
                <p class="text-sm text-slate-500">
                  <%= inquiry.company %>
                </p>
              <% end %>

            </td>

            <!-- Subject -->
            <td class="px-6 py-5 align-middle text-slate-700">
              <%= inquiry.subject.presence || "-" %>
            </td>

            <!-- Status -->
            <td class="px-6 py-5 align-middle">

              <div class="flex justify-center">

                <%= form_with url: update_status_admin_inquiry_path(inquiry),
                              method: :patch,
                              local: true,
                              class: "m-0" do |form| %>

                  <%= form.select :status,
                        Inquiry.statuses.keys.map { |status| [status.titleize, status] },
                        { selected: inquiry.status },
                        {
                          onchange: "this.form.requestSubmit()",
                          class: "w-36 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:border-[#0A3A8D] focus:outline-none focus:ring-2 focus:ring-blue-100"
                        } %>

                <% end %>

              </div>

            </td>

            <!-- Received -->
            <td class="px-6 py-5 align-middle text-slate-600 whitespace-nowrap">
              <%= inquiry.created_at.strftime("%d %b %Y") %>
            </td>

            <!-- Actions -->
            <td class="px-6 py-5 align-middle">

              <div class="flex items-center justify-center gap-3">

                <%= link_to "View",
                      admin_inquiry_path(inquiry),
                      class: "rounded-lg bg-blue-100 px-4 py-2 text-sm font-medium text-blue-700 hover:bg-blue-200" %>

                <%= link_to "Delete",
                      admin_inquiry_path(inquiry),
                      data: {
                        turbo_method: :delete,
                        turbo_confirm: "Are you sure you want to delete this inquiry?"
                      },
                      class: "rounded-lg bg-red-100 px-4 py-2 text-sm font-medium text-red-700 hover:bg-red-200" %>

              </div>

            </td>

          </tr>

        <% end %>

      </tbody>

    </table>

    <% if @inquiries.empty? %>

      <div class="py-16 text-center">

        <p class="text-lg font-medium text-slate-500">
          No inquiries found.
        </p>

      </div>

    <% end %>

  </div>

</div>
