<%= form_with(model: [:admin, @product], class: "space-y-8") do |f| %>

  <% if @product.errors.any? %>
    <div class="rounded-xl border border-red-200 bg-red-50 p-5">
      <h3 class="font-semibold text-red-700">
        Please fix the following errors:
      </h3>

      <ul class="mt-2 list-disc pl-5 text-sm text-red-600">
        <% @product.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="rounded-2xl bg-white p-8 shadow-sm ring-1 ring-slate-200">

    <div class="space-y-6">

      <!-- Name -->
      <div>
        <%= f.label :name,
              class: "mb-2 block text-sm font-semibold text-slate-700" %>

        <%= f.text_field :name,
              class: "w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 placeholder:text-slate-400 focus:border-[#00A651] focus:ring-4 focus:ring-green-100 focus:outline-none" %>
      </div>

      <!-- Slug -->
      <div>
        <%= f.label :slug,
              class: "mb-2 block text-sm font-semibold text-slate-700" %>

        <%= f.text_field :slug,
              class: "w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 placeholder:text-slate-400 focus:border-[#00A651] focus:ring-4 focus:ring-green-100 focus:outline-none" %>
      </div>

      <!-- Strength -->
      <div>
        <%= f.label :strength,
              class: "mb-2 block text-sm font-semibold text-slate-700" %>

        <%= f.text_field :strength,
              class: "w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 placeholder:text-slate-400 focus:border-[#00A651] focus:ring-4 focus:ring-green-100 focus:outline-none" %>
      </div>

      <!-- Dosage Form -->
      <div>
        <%= f.label :dosage_form,
              class: "mb-2 block text-sm font-semibold text-slate-700" %>

        <%= f.text_field :dosage_form,
              class: "w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 placeholder:text-slate-400 focus:border-[#00A651] focus:ring-4 focus:ring-green-100 focus:outline-none" %>
      </div>

      <!-- Segment -->
      <div>
        <%= f.label :segment,
              class: "mb-2 block text-sm font-semibold text-slate-700" %>

        <%= f.text_field :segment,
              class: "w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 placeholder:text-slate-400 focus:border-[#00A651] focus:ring-4 focus:ring-green-100 focus:outline-none" %>
      </div>

      <!-- Short Description -->
      <div>
        <%= f.label :short_description,
              class: "mb-2 block text-sm font-semibold text-slate-700" %>

        <%= f.text_area :short_description,
              rows: 3,
              class: "w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 placeholder:text-slate-400 focus:border-[#00A651] focus:ring-4 focus:ring-green-100 focus:outline-none" %>
      </div>

      <!-- Description -->
      <div>
        <%= f.label :description,
              class: "mb-2 block text-sm font-semibold text-slate-700" %>

        <%= f.text_area :description,
              rows: 5,
              class: "w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 placeholder:text-slate-400 focus:border-[#00A651] focus:ring-4 focus:ring-green-100 focus:outline-none" %>
      </div>

      <!-- Composition -->
      <div>
        <%= f.label :composition,
              class: "mb-2 block text-sm font-semibold text-slate-700" %>

        <%= f.text_area :composition,
              rows: 4,
              class: "w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 placeholder:text-slate-400 focus:border-[#00A651] focus:ring-4 focus:ring-green-100 focus:outline-none" %>
      </div>

      <!-- Indications -->
      <div>
        <%= f.label :indications,
              class: "mb-2 block text-sm font-semibold text-slate-700" %>

        <%= f.text_area :indications,
              rows: 4,
              class: "w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 placeholder:text-slate-400 focus:border-[#00A651] focus:ring-4 focus:ring-green-100 focus:outline-none" %>
      </div>

      <!-- Storage -->
      <div>
        <%= f.label :storage,
              class: "mb-2 block text-sm font-semibold text-slate-700" %>

        <%= f.text_field :storage,
              class: "w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 placeholder:text-slate-400 focus:border-[#00A651] focus:ring-4 focus:ring-green-100 focus:outline-none" %>
      </div>

      <!-- Packaging -->
      <div>
        <%= f.label :packaging,
              class: "mb-2 block text-sm font-semibold text-slate-700" %>

        <%= f.text_field :packaging,
              class: "w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 placeholder:text-slate-400 focus:border-[#00A651] focus:ring-4 focus:ring-green-100 focus:outline-none" %>
      </div>

      <!-- Image -->
      <div>
        <%= f.label :image,
              class: "mb-2 block text-sm font-semibold text-slate-700" %>

        <%= f.file_field :image,
              class: "block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-700 file:mr-4 file:rounded-lg file:border-0 file:bg-[#00A651] file:px-4 file:py-2 file:font-semibold file:text-white hover:file:bg-green-700" %>
      </div>

      <!-- Featured -->
      <div class="flex items-center gap-3 rounded-xl border border-slate-200 bg-slate-50 p-4">

        <%= f.check_box :featured,
              class: "h-5 w-5 rounded border-slate-300 text-[#00A651] focus:ring-[#00A651]" %>

        <%= f.label :featured,
              class: "font-medium text-slate-700" %>

      </div>

    </div>

  </div>

  <div class="flex justify-end gap-4">

    <%= link_to "Cancel",
          admin_products_path,
          class: "rounded-xl border border-slate-300 bg-white px-6 py-3 font-semibold text-slate-700 hover:bg-slate-100" %>

    <%= f.submit class: "rounded-xl bg-[#00A651] px-8 py-3 font-semibold text-white shadow hover:bg-green-700" %>

  </div>

<% end %>
