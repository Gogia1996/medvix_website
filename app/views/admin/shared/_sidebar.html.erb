<aside class="flex w-72 flex-col bg-gradient-to-b from-[#0A3A8D] to-[#0E8A4D] text-white shadow-2xl">

  <!-- Logo -->
  <div class="border-b border-white/10 px-8 py-8">

    <div class="flex items-center gap-4">

      <div class="rounded-2xl bg-white p-2 shadow-lg">
        <%= image_tag "logo.jpeg",
            class: "h-16 w-auto" %>
      </div>

      <div>

        <h2 class="text-2xl font-bold tracking-wide">
          Medvix
        </h2>

        <p class="text-sm text-blue-100">
          Administration Panel
        </p>

      </div>

    </div>

  </div>

  <!-- Navigation -->
  <nav class="flex-1 space-y-3 px-5 py-8">

    <!-- Dashboard -->
    <%= link_to admin_root_path,
          class: "group flex items-center rounded-2xl px-5 py-4 transition-all duration-300 #{current_page?(admin_root_path) ? 'bg-white text-[#0A3A8D] shadow-lg' : 'hover:bg-white/10'}" do %>

      <svg xmlns="http://www.w3.org/2000/svg"
           fill="none"
           viewBox="0 0 24 24"
           stroke-width="1.8"
           stroke="currentColor"
           class="mr-4 h-6 w-6">

        <path stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 10.5 12 3l9 7.5V21H3z"/>

      </svg>

      <span class="font-medium">
        Dashboard
      </span>

    <% end %>

    <!-- Products -->
    <%= link_to admin_products_path,
          class: "group flex items-center rounded-2xl px-5 py-4 transition-all duration-300 #{controller_name == 'products' ? 'bg-white text-[#0A3A8D] shadow-lg' : 'hover:bg-white/10'}" do %>

      <svg xmlns="http://www.w3.org/2000/svg"
           fill="none"
           viewBox="0 0 24 24"
           stroke-width="1.8"
           stroke="currentColor"
           class="mr-4 h-6 w-6">

        <path stroke-linecap="round"
              stroke-linejoin="round"
              d="M20.25 7.5L12 3 3.75 7.5M20.25 7.5V16.5L12 21M20.25 7.5L12 12M12 21L3.75 16.5V7.5M3.75 7.5L12 12"/>

      </svg>

      <span class="font-medium">
        Products
      </span>

    <% end %>

    <!-- Inquiries -->
    <%= link_to admin_inquiries_path,
          class: "group flex items-center rounded-2xl px-5 py-4 transition-all duration-300 #{controller_name == 'inquiries' ? 'bg-white text-[#0A3A8D] shadow-lg' : 'hover:bg-white/10'}" do %>

      <svg xmlns="http://www.w3.org/2000/svg"
           fill="none"
           viewBox="0 0 24 24"
           stroke-width="1.8"
           stroke="currentColor"
           class="mr-4 h-6 w-6">

        <path stroke-linecap="round"
              stroke-linejoin="round"
              d="M21.75 6.75v10.5A2.25 2.25 0 0119.5 19.5h-15A2.25 2.25 0 012.25 17.25V6.75A2.25 2.25 0 014.5 4.5h15A2.25 2.25 0 0121.75 6.75z"/>

        <path stroke-linecap="round"
              stroke-linejoin="round"
              d="M2.25 7.5L12 13.5 21.75 7.5"/>

      </svg>

      <span class="font-medium">
        Inquiries
      </span>

    <% end %>

  </nav>

  <!-- Footer -->
  <div class="border-t border-white/10 p-6">

    <div class="mb-5 rounded-2xl bg-white/10 p-4">

      <p class="text-sm text-blue-100">
        Logged in as
      </p>

      <p class="mt-1 truncate font-semibold">
        <%= current_admin.email %>
      </p>

    </div>

    <%= button_to destroy_admin_session_path,
          method: :delete,
          class: "flex w-full items-center justify-center rounded-2xl bg-white px-5 py-3 font-semibold text-[#0A3A8D] transition duration-300 hover:scale-[1.02] hover:bg-slate-100" do %>

      <svg xmlns="http://www.w3.org/2000/svg"
           fill="none"
           viewBox="0 0 24 24"
           stroke-width="2"
           stroke="currentColor"
           class="mr-2 h-5 w-5">

        <path stroke-linecap="round"
              stroke-linejoin="round"
              d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6A2.25 2.25 0 005.25 5.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m-6-3h12m0 0l-3-3m3 3l-3 3"/>

      </svg>

      Logout

    <% end %>

  </div>

</aside>
